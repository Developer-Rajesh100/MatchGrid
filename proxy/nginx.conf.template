# Single public entry point for the whole stack (reference/implementation.txt
# Phase 10.4): terminates TLS, reverse-proxies /api/* and /ws/* to the
# backend, and everything else to the frontend's own static-file nginx.
#
# Certs: expects proxy/certs/fullchain.pem + proxy/certs/privkey.pem,
# mounted read-only into the container (see docker-compose.yml). A
# self-signed pair for local testing can be generated with
# proxy/generate-dev-cert.sh — for a real deployment, replace those two
# files with real certificates (e.g. from Let's Encrypt/certbot) using the
# same two filenames; nothing else needs to change.

server {
    listen 80;
    server_name _;

    # Lets an ACME HTTP-01 challenge (e.g. certbot) resolve without going
    # through HTTPS first, if that's how real certs end up being issued.
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        # $host (strips any port) + the real external HTTPS port, injected
        # via envsubst at container start (see the Dockerfile and
        # docker-compose.yml's HTTPS_PORT). Using $host or $http_host alone
        # is not reliable here: HTTP and HTTPS can be published on
        # unrelated external ports (e.g. this project's own docker-compose
        # defaults, 8090/8443, chosen only to avoid colliding with another
        # project's 80/443 on the same dev machine) — nginx has no way to
        # derive one from the other, so the actual HTTPS port has to be
        # supplied explicitly. In the standard production case
        # (HTTPS_PORT=443) an explicit ":443" is harmless and correct.
        return 301 https://$host:${HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Basic security headers (reference/plan.txt Section 8/10's noted gap —
    # "no security headers configured"), added at this single edge point
    # rather than duplicated in the app or the frontend's own nginx.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' wss: ws:; frame-ancestors 'none'" always;

    client_max_body_size 2m;

    # Real-time match updates (app/routers/websocket.py) — needs the
    # Upgrade/Connection headers forwarded and a long read timeout so an
    # idle-but-open connection isn't cut mid-tournament.
    location /ws/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://frontend:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
