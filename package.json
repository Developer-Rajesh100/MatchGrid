{
  "name": "dcl-score-board",
  "version": "1.0.0",
  "private": true,
  "description": "DCL Season 5 — Digital Scoreboard",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "backend": "cd backend && ./venv/bin/uvicorn app.main:app --reload --port 8001",
    "test:frontend": "npm --prefix frontend run test",
    "test:backend": "cd backend && ./venv/bin/pytest",
    "test": "npm run test:backend && npm run test:frontend"
  }
}
