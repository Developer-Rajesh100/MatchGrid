# Copy to .env and adjust for your environment.

APP_NAME="MatchGrid API"
ENVIRONMENT=development
DEBUG=true

# Must match MONGO_INITDB_ROOT_USERNAME / MONGO_INITDB_ROOT_PASSWORD in the
# root .env.example / docker-compose.yml (Mongo container's root user).
MONGO_URI=mongodb://dcl_admin:change-me-strong-password@localhost:27018/?authSource=admin
MONGO_DB_NAME=matchgrid
# Production: use the Atlas string (mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority).
# A localhost URI, or the template password above, is refused when ENVIRONMENT=production.
# AUTO_SEED must be false in production (it is refused otherwise).
AUTO_SEED=false

# Generate a real value with: python -c "import secrets; print(secrets.token_hex(32))"
# ENVIRONMENT=production refuses to boot with this placeholder or any other
# known dev value — see app/core/production_safety.py.
JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# Created by migrations if no admin account exists yet. In production the password must be at
# least 12 characters and not a known placeholder — migration 0003 refuses to bootstrap otherwise.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password

# How many reverse proxies sit in front of the API and append to X-Forwarded-For
# (1 on Render, DigitalOcean App Platform or the bundled nginx; 0 only when the API is reached
# directly on localhost). Used for per-IP login throttling — see app/core/config.py.
# Production requires >= 1.
TRUSTED_PROXY_HOPS=1

# Comma-separated exact frontend origins. These also gate the live WebSocket handshake in
# production. In production every entry must be https://, a public host, no wildcard and no path
# (e.g. https://matchgrid.vercel.app); the app refuses to boot otherwise.
CORS_ORIGINS=http://localhost:5173

TOURNAMENT_NAME="MatchGrid"
TOURNAMENT_SEASON=1

# Cloudflare R2 Media Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=matchgrid-media
# https:// in production; add this origin to the frontend's CSP img-src (apps/frontend/vercel.json)
R2_PUBLIC_BASE_URL=https://pub-your-id.r2.dev

# --- Deployed production checklist: see DEPLOYMENT.md ---
# ENVIRONMENT=production   DEBUG=false   AUTO_SEED=false   AUTO_MIGRATE=true
