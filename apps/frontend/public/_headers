# Cloudflare Workers static assets: response headers (https://developers.cloudflare.com/workers/static-assets/headers/).
# Rules that match the same path are merged, so Cache-Control is only set on /assets/* (Vite's
# content-hashed output). Everything else, index.html included, keeps the default revalidation.
# If the API or media move to a custom domain, update connect-src / img-src below.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://matchgrid-api.onrender.com wss://matchgrid-api.onrender.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
