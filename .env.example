# MongoDB Docker Configuration
# Used by docker-compose.yml. Copy to .env and adjust if needed.

MONGO_INITDB_ROOT_USERNAME=dcl_admin
MONGO_INITDB_ROOT_PASSWORD=change-me-strong-password
# Set to 27018 if 27017 is already in use by another service on your machine:
MONGO_PORT=27018
MONGO_DB_NAME=matchgrid
