# Used by docker-compose.yml. Copy to .env and adjust.

MONGO_INITDB_ROOT_USERNAME=dcl_admin
MONGO_INITDB_ROOT_PASSWORD=change-me-strong-password
MONGO_PORT=27018
MONGO_DB_NAME=dcl_scoreboard

# The reverse proxy's published ports (Phase 10 — see proxy/nginx.conf.template).
# Defaults to 8090/8443 rather than the standard 80/443 only because this
# was built/tested on a dev machine where another project already
# occupies 80/443 — on a real deployment host, set these to 80 and 443.
HTTP_PORT=8090
HTTPS_PORT=8443
